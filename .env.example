# Firm Garage — configuration reference.
# This site is static HTML (no build step), so these values are NOT read from the environment at runtime.
# Edit them in the files named below. Never commit secrets; only the Supabase *publishable* (anon) key belongs in the front end.

# src/services/supabase.js
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# src/config/siteConfig.js
TAWK_PROPERTY_ID=
TAWK_WIDGET_ID=
CONTACT_EMAIL=
SUPPORT_EMAIL=
BUSINESS_EMAIL=
PHONE=
CONTACT_FORM_ENDPOINT=
SOCIAL_X=
SOCIAL_INSTAGRAM=
SOCIAL_YOUTUBE=
SOCIAL_DISCORD=
SOCIAL_TELEGRAM=
SOCIAL_LINKEDIN=
SOCIAL_FACEBOOK=

# NEVER put these in front-end code or in git:
# SUPABASE_SERVICE_ROLE_KEY=
